SELECT 
    p.name AS Patient_Name,
    d.name AS Doctor_Name,
    a.appointment_date
FROM Appointments a
JOIN Patients p ON a.patient_id = p.patient_id
JOIN Doctors d ON a.doctor_id = d.doctor_id;

SELECT COUNT(*) AS Total_Patients FROM Patients;

SELECT SUM(amount) AS Total_Billing FROM Billing;

SELECT AVG(amount) AS Average_Billing FROM Billing;

SELECT name
FROM Patients
WHERE patient_id IN (
    SELECT patient_id
    FROM Billing
    WHERE amount > 4000
);

CREATE VIEW PatientBills AS
SELECT p.name, b.amount
FROM Patients p
JOIN Billing b ON p.patient_id = b.patient_id;

SELECT * FROM PatientBills;

